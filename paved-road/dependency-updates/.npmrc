# Copy to the project root, next to package.json.

# Install only versions published at least 7 days ago (npm 11.10 and later).
# If a security fix is newer than that, add the package to min-release-age-exclude.
min-release-age=7

# Never run dependency install scripts (preinstall, install, postinstall).
# Works on every npm version. See README.md for npm 12's allowScripts alternative.
ignore-scripts=true

# Don't install dependencies straight from git repos or tarball URLs.
# This is the default from npm 12; set it for npm 11 too.
allow-git=none
allow-remote=none
